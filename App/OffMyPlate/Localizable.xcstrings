      }
    },
    "C-092": {
      "comment": "Full medical disclaimer note (S-37, Settings -> About).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OffMyPlate suggests meals based on what you tell it. It isn't medical advice and can't guarantee a dish is free of allergens: packaged ingredients can contain hidden allergens or traces. Always check ingredients and labels. For allergies or medical diets, follow advice from your doctor or dietitian."
          }
        }
      }
    },
