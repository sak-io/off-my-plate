    "C-021": {
      "comment": "One-sentence reason on the safety question (S-02 and gate cover).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'll never put these in a plan, so I need to know before I suggest anything."
          }
