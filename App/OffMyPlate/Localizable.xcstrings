{
  "sourceLanguage": "en",
  "strings": {
    "C-021": {
      "comment": "One-sentence reason on the safety question (S-02 and gate cover).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'll never put these in a plan, so I need to know before I suggest anything."
          }
        }
      }
    },
    "C-030": {
      "comment": "Safety gate cover title for one member. %@ is the member's name or label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Does %@ have an allergy or something they must avoid?"
          }
        }
      }
    },
    "C-030a": {
      "comment": "Safety gate cover progress when several members are unasked: index, then total.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld of %2$lld"
          }
        }
      }
    },
    "C-050": {
      "comment": "Plan loading text (S-04, S-10).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Planning your week…"
          }
        }
      }
    },
    "C-052": {
      "comment": "Plan generation or save error.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I couldn't make a plan just now. Please try again."
