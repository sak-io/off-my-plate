      "comment": "Disclaimer footer on the safety question and the must-avoid list (S-02, S-33).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OffMyPlate isn't medical advice. Always check ingredients and labels."
