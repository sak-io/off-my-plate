      }
    },
    "C-091": {
      "comment": "Disclaimer footer on the plan and meal detail (S-10, S-11).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not medical advice. Check ingredients and labels, especially for allergies."
